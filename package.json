{
  "name": "@xpo/feedback",
  "version": "0.1.0",
  "description": "Client for the Xpo Feedback Center: feedback, support requests, error reports and analytics. Works in browsers and Node 18+.",
  "keywords": [
    "feedback",
    "error-reporting",
    "crash-reporting",
    "analytics",
    "support"
  ],
  "homepage": "https://github.com/xpodev/fbc-client-ts#readme",
  "bugs": {
    "url": "https://github.com/xpodev/fbc-client-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xpodev/fbc-client-ts.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
